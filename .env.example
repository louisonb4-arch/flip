# Supabase (si absent → DevStore local, app tourne sans clés)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push VAPID (générer avec : npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ProfileFetcher : mock | external
PROFILE_FETCHER=mock
PROFILE_PROVIDER_URL=
PROFILE_PROVIDER_KEY=

# Protection du cron en production
CRON_SECRET=

# Stripe (plus tard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
